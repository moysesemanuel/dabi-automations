# --- Infra local ---
DATABASE_URL=postgresql://dabi:dabi@localhost:5440/dabi?schema=public
REDIS_URL=redis://localhost:6390

# --- Meta / Instagram (NUNCA commitar valores reais) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-aleatorio
META_GRAPH_VERSION=v23.0

# --- Segurança ---
# 32 bytes em base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=

# --- Apps ---
API_PORT=3001
WEB_URL=http://localhost:3000
# OAuth do Instagram (Unified Login). Secret em META_APP_SECRET. Não use valores inventados.
META_LOGIN_CONFIG_ID=
# Vazio => WEB_URL + /instagram/callback. Precisa ser HTTPS (domínio de dev estável).
# E-mail de ajuda assistida no assistente de conexão (vazio => botão de ajuda oculto).
SUPPORT_EMAIL=
# Assinatura de webhook por conta: vazio = desligado | "*" = todas | lista de IDs do Instagram.
INSTAGRAM_WEBHOOK_SUBSCRIBE_ACCOUNTS=
INSTAGRAM_OAUTH_REDIRECT_URI=
# Host do túnel HTTPS em dev (sem https://), usado pelo Next em allowedDevOrigins.
DEV_PUBLIC_HOST=

# Cadastro aberto além do primeiro usuário (deixe false em produção)
ALLOW_REGISTRATION=false

# Envio real de respostas privadas (DMs) pelo worker. Mantenha false até autorizar.
INSTAGRAM_SEND_ENABLED=false
# Reprocessar entregas PENDING antigas ao subir o worker (exige o envio ligado). Mantenha false.
INSTAGRAM_RESUME_PENDING_ENABLED=false

# Resposta pública automática ao comentário (só após a DM ser SENT). Mantenha false até autorizar.
INSTAGRAM_PUBLIC_REPLY_ENABLED=false

# Proxies confiáveis para ler o IP do cliente (X-Forwarded-For). Em produção, ajuste ao seu balanceador.
TRUST_PROXY=loopback

# Se o Redis cair, o limitador de login usa contador local ("local") ou nega o login com 503 ("closed").
LOGIN_THROTTLE_REDIS_DOWN=local

# Formato do job de comentários na fila: legacy (padrão) | minimal ({ eventId } apenas). Não mude sem autorização.
COMMENT_JOB_FORMAT=legacy

# Chaves HMAC independentes (ao menos 32 caracteres cada; distintas entre si e de JWT_SECRET e TOKEN_ENCRYPTION_KEY).
# OBRIGATÓRIAS em produção (a API não inicia sem elas). Em desenvolvimento são opcionais:
#  - sem AUDIT_HMAC_KEY: a auditoria de login falho não grava nenhum identificador derivado do e-mail;
#  - sem RATE_LIMIT_HMAC_KEY: o limitador usa uma chave temporária do processo (continua ativo).
# Gere com: openssl rand -base64 48
AUDIT_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=
