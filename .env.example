# --- Infra local ---
DATABASE_URL=postgresql://dabi:dabi@localhost:5440/dabi?schema=public
REDIS_URL=redis://localhost:6379

# --- Meta / Instagram (NUNCA commitar valores reais) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-aleatorio
META_GRAPH_VERSION=v23.0

# --- Segurança ---
# 32 bytes em base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=

# --- Apps ---
API_PORT=3001
WEB_URL=http://localhost:3000

# Cadastro aberto além do primeiro usuário (deixe false em produção)
ALLOW_REGISTRATION=false

# Envio real de respostas privadas (DMs) pelo worker. Mantenha false até autorizar.
INSTAGRAM_SEND_ENABLED=false
# Reprocessar entregas PENDING antigas ao subir o worker (exige o envio ligado). Mantenha false.
INSTAGRAM_RESUME_PENDING_ENABLED=false
